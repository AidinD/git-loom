{
  "name": "loom",
  "version": "1.1.19",
  "description": "A visual Git client with a direct-manipulation commit graph",
  "main": "./out/main/index.js",
  "author": "Aidin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run clean && electron-vite build && electron-builder --publish never",
    "release": "npm run clean && electron-vite build && electron-builder --publish always",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "clean": "node -e \"const {rmSync}=require('node:fs');for(const d of ['dist','out'])rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "dockview": "^6.6.1",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
